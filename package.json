{
  "name": "unicontext",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first context layer for university life",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @unicontext/web build",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @unicontext/web typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm build && tsc -p tsconfig.test.json && pnpm lint && pnpm test",
    "unicontext": "node apps/cli/dist/bin.js",
    "unicontextd": "node apps/daemon/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0"
  }
}
